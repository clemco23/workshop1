generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MissionType {
  INTERMITTENCE
  FREELANCE
}

enum MissionStatus {
  PROPOSED
  CONFIRMED
  TERMINATED
}

enum DocumentCategory {
  CONTRACT
  EMPLOYER_ATTESTATION
  QUOTE
  INVOICE
  OTHER
}

enum ProjectTag {
  PRO
  PERSONAL
}

model User {
  id         String   @id @default(uuid())
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  email      String   @unique
  createdAt  DateTime @default(now()) @map("created_at")

  missions   Mission[]
  documents  Document[]
  projects   Project[]
  settings   ConfigSeuil?
  portfolios PortfolioPublic?
  codes      Code[]

  @@map("users")
}

model ConfigSeuil {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  seuilHeuresAnnuel   Int      @default(507) @map("seuil_heures_annuel")
  heuresJourDefaut    Decimal  @default(8) @map("heures_jour_defaut")
  fenetreMois         Int      @default(12) @map("fenetre_mois")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("config_seuil")
}

model Mission {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  clientProduction String       @map("client_production")
  type           MissionType
  dateDebut      DateTime      @map("date_debut")
  dateFin        DateTime?     @map("date_fin")
  statut         MissionStatus @default(PROPOSED)
  heures         Decimal?      @db.Decimal(6, 2)
  montantHt      Decimal?      @db.Decimal(10, 2) @map("montant_ht")
  nbJours        Decimal?      @db.Decimal(5, 2) @map("nb_jours")
  note           String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]
  projects  Project[]

  @@index([userId, type])
  @@index([dateDebut, dateFin])
  @@map("mission")
}

model Document {
  id           String            @id @default(uuid())
  userId       String            @map("user_id")
  missionId    String?           @map("mission_id")
  categorie    DocumentCategory
  fichierPath  String            @map("fichier_path")
  nomOriginal  String            @map("nom_original")
  taille       Int
  mimeType     String            @map("mime_type")
  uploadedAt   DateTime          @default(now()) @map("uploaded_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([missionId])
  @@map("document")
}

model Project {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  missionId   String?     @map("mission_id")
  titre       String
  description String?
  tag         ProjectTag
  date        DateTime
  lienVideo   String      @map("lien_video")
  createdAt   DateTime    @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     Mission?  @relation(fields: [missionId], references: [id], onDelete: SetNull)
  portfolioLinks PortfolioPublicProjet[]

  @@map("projet")
}

model PortfolioPublic {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  slug        String   @unique
  titrePage   String?  @map("titre_page")
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  user     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects PortfolioPublicProjet[]

  @@map("portfolio_public")
}

model PortfolioPublicProjet {
  id                 String @id @default(uuid())
  portfolioPublicId  String @map("portfolio_public_id")
  projetId           String @map("projet_id")
  ordre              Int

  portfolioPublic PortfolioPublic @relation(fields: [portfolioPublicId], references: [id], onDelete: Cascade)
  projet          Project         @relation(fields: [projetId], references: [id], onDelete: Cascade)

  @@unique([portfolioPublicId, projetId])
  @@map("portfolio_public_projet")
}

model Code {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  code      String
  expireAt  DateTime @map("expire_at")
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("codes")
}