DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret

# Compte Gmail dédié à l'envoi des codes et mot de passe d'application Google.
GMAIL_USER=workshop.codes@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Stockage des médias des projets dans Supabase Storage.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_PROJECT_MEDIA_BUCKET=project-media
# Facultatif : bucket prive pour les justificatifs. Sans cette variable,
# les documents sont ranges dans project-media/<userId>/documents.
SUPABASE_DOCUMENT_BUCKET=documents

# URL publique du front, utilisée pour générer les liens des portfolios.
PUBLIC_APP_URL=http://localhost:5173
