DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret

# Clé API transactionnelle Brevo et adresse expéditrice vérifiée dans Brevo.
BREVO_API_KEY=xkeysib-your-api-key
BREVO_SENDER_EMAIL=bonjour@example.com
BREVO_SENDER_NAME=Workshop
# true valide la requête sans envoyer d'email ; false effectue un envoi réel.
BREVO_SANDBOX=true
