# Copier ce fichier en `.env` puis renseigner les valeurs.
# Seules les variables prefixees par VITE_ sont exposees au code client (Vite),
# donc n'y mettre AUCUN secret : tout est visible dans le bundle.

# URL de base de l'API Express (voir server/src/index.js)
VITE_API_URL=http://localhost:4000

# Tant que le back n'expose pas les endpoints metier, le client sert les donnees
# simulees de src/mocks/. Passer a `false` pour taper la vraie API.
# Non definie = mocks actifs.
VITE_USE_MOCKS=false
